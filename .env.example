# SehtSnap environment variables
# Copy this file to .env and put real values in .env only.
# Never put real keys in this file, because it is committed to GitHub.

# AI vision provider: gemini or openai
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini
# Get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required only when AI_PROVIDER=openai
# Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides. Leave empty to use the app defaults.
GEMINI_MODEL=
OPENAI_MODEL=

# Set to true to use local demo data even when Firebase is configured.
DEMO_MODE=false

# Optional. Leave both empty to run in demo mode with local SQLite storage.
# Firebase Console > Project settings > General > Web API Key
FIREBASE_API_KEY=
# Firebase Console > Project settings > General > Project ID
FIREBASE_PROJECT_ID=
